<html lang="">
<head>
  <title><%= @config.title %></title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
  <link rel="stylesheet" href="/assets/<%= @config.theme %>/css/main.css" />
  <noscript><link rel="stylesheet" href="/assets/<%= @config.theme %>/css/noscript.css" /></noscript>
</head>
<body class="is-preload">

<!-- Wrapper -->
<div id="wrapper">

  <!-- Main -->
  <section id="main">

    <%= yield %>

  </section>

  <!-- Footer -->
  <section id="footer">
    <section>
      <p>All images are taken by Miki. <strong>It is not allowed to share those images.</strong></p>
    </section>
    <section>
      <ul class="icons">
        <li><a href="https://www.uneven-eyes.info" class="icon brands fa-instagram"><span class="label">Uneven Eyes - Photography</span></a></li>
      </ul>
      <ul class="copyright">
        <li>&copy; 2026+ Unforgiven.pl</li>
        <li>Design: <a href="https://html5up.net">HTML5 UP</a> (theme: <em>Parallelism</em>)</li>
        <li>Additional coding: Miki</li>
        <li>This site runs Myway.</li>
        <% if @context.user.login %>
        <li>
          Welcome, <%= @context.user.name %>!
          <% if @context.user.login && @context.collection&.owner == @context.user.login %>
            <a href="/edit/<%= @context.collection_name %>" rel="nofollow">You can edit the details of this collection.</a>
            <% if @context.gallery_name %>
              <a href="/edit/<%= @context.collection_name %>/<%= @context.gallery_name %>" rel="nofollow">You can also edit details of this gallery.</a>
            <% end %>
          <% end %>
        </li>
        <% end %>
        <% if !@context.user.admin %>
        <li><a href="/admin" rel="nofollow">Admin login</a></li>
        <% else %>
        <li>You are logged in as admin. <a href="/admin/collection" rel="nofollow">Create a new collection.</a></li>
        <% end %>
      </ul>
    </section>
  </section>

</div>

<!-- Scripts -->
<script src="/assets/<%= @config.theme %>/js/jquery.min.js"></script>
<script src="/assets/<%= @config.theme %>/js/jquery.poptrox.min.js"></script>
<script src="/assets/<%= @config.theme %>/js/browser.min.js"></script>
<script src="/assets/<%= @config.theme %>/js/breakpoints.min.js"></script>
<script src="/assets/<%= @config.theme %>/js/util.js"></script>
<script src="/assets/<%= @config.theme %>/js/main.js"></script>

</body>
</html>
