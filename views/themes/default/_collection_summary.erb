<article class="nice-box with-border collection-summary">
  <header><h2><a href="/collection/<%= name %>" rel="nofollow" class="link-to-collection"><%= collection.title %></a></h2></header>
  <div class="description"><%= collection.description %></div>
  <footer>
    <ul class="icons">
      <% if collection.operations.allow_visitors %>
        <li><span class="fa-solid fa-users" title="Users can register" /></li>
      <% end %>
      <% if collection.operations.allow_reactions %>
        <li><span class="fa-solid fa-plus-minus" title="Reactions allowed from logged in users" /></li>
      <% end %>
      <% if collection.operations.allow_comments %>
        <li><span class="fa-regular fa-comments" title="Logged in users can comment" /></li>
      <% end %>
      <% if collection.operations.allow_downloads %>
        <li><span class="fa-solid fa-file-arrow-down" title="Users can download full-size images" /></li>
      <% end %>
      <% if collection.password && !collection.password.empty? %>
        <li><span class="fa-solid fa-user-lock" title="Collection is password-protected" /></li>
      <% end %>
    </ul>
    <ul class="actions">
      <% if @context.user.login == collection.owner %>
        <a href="/edit/<%= name %>" rel="nofollow" class="collection-edit-link has-icon">You can edit settings of this collection.</a>
      <% end %>
    </ul>
  </footer>
</article>
