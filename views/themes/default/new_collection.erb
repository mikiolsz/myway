<h1>New collection</h1>
<p>Create a new collection. The galleries will be discovered automatically, provided there is access to the underlying directory and there are subdirectories in it.</p>
<form id="new-collection" action="/admin/collection" method="post">
  <fieldset>
    <legend>Essentials of the collection</legend>
    <div class="form-row">
    <label for="name">Collection name</label>
    <input type="text" id="name" name="name" placeholder="Collection name" required="required" minlength="3" maxlength="16" pattern="[a-z0-9_-]{3,16]" value="<%= params['name'] %>"/>
    </div>
    <p class="explanation">Collection name is used in the url address. It can be 3 to 16 characters long and may only contain lowercase numbers, digits, an underscore and a minus sign.</p>
    <div class="form-row">
    <label for="source">Source directory</label>
    <input type="text" id="source" name="source" placeholder="/path/to/photos" required="required" minlength="3" value="<%= collection.source %>"/>
    </div>
    <p class="explanation">Galleries will be read from this directory. Please make sure the directory exists and that Myway can access it. Minimum required length is 3 characters.</p>
    <div class="form-row">
    <label for="title">Collection title</label>
    <input type="text" id="title" name="title" required="required" maxlength="64" minlength="3" value="<%= collection.title %>"/>
    </div>
    <p class="explanation">This title will be shown in many places on the screen.</p>
  </fieldset>
  <fieldset>
    <legend>Gallery and image sorting</legend>
    <div class="form-row">
    <label for="sort_galleries_by">Sort galleries by</label>
    <select id="sort_galleries_by" name="sort_galleries_by">
      <option value="name"<%= ' selected="selected"' if !collection.sort_galleries_by || (collection.sort_galleries_by == 'name') %>>Name (alphabetic)</option>
      <option value="date"<%= ' selected="selected"' if collection.sort_galleries_by == 'date' %>>Date (from oldest to newest)</option>
      <option value="title"<%= ' selected="selected"' if collection.sort_galleries_by == 'title' %>>Title (alphabetic)</option>
    </select>
    </div>
    <div class="form-row">
      <label for="reverse_gallery_sort">Reverse gallery sorting order?</label>
      <input type="checkbox" id="reverse_gallery_sort" name="reverse_gallery_sort"<%= ' checked = "checked"' if collection.reverse_gallery_sort %>/>
    </div>
    <p class="explanation">Choose how to sort galleries within this collection. Since date and title are optional, if those are missing for a gallery, its name will be used instead.</p>
    <div class="form-row">
      <label for="sort_images_by">Sort images in galleries by</label>
      <select id="sort_images_by" name="sort_images_by">
        <option value="name"<%= ' selected="selected"' if !collection.sort_images_by || (collection.sort_images_by == 'name') %>>Name (alphabetic)</option>
        <option value="date"<%= ' selected="selected"' if collection.sort_images_by == 'date' %>>Date (from oldest to newest)</option>
        <option value="title"<%= ' selected="selected"' if collection.sort_images_by == 'title' %>>Title (alphabetic)</option>
      </select>
    </div>
    <div class="form-row">
      <label for="reverse_gallery_sort">Reverse gallery sorting order?</label>
      <input type="checkbox" id="reverse_gallery_sort" name="reverse_gallery_sort"<%= ' checked = "checked"' if collection.reverse_gallery_sort %>/>
    </div>
    <p class="explanation">Choose how to sort images within galleries of this collection. Since date and title are optional, if those are missing for an image, its name will be used instead.</p>
  </fieldset>
  <fieldset>
    <legend>Configuration</legend>
    <div class="form-row">
    <label for="allow_visitors">Allow visitors to create accounts?</label>
    <input type="checkbox" id="allow_visitors" name="allow_visitors" value="true" <%= 'checked="checked"' if collection&.operations&.allow_visitors %>/>
    </div>
    <p class="explanation">When enabled, visitors can create accounts (login and password). All user accounts are specific to this particular collection.</p>
    <div class="form-row">
    <label for="allow_reactions">Allow visitors to react to images?</label>
    <input type="checkbox" id="allow_reactions" name="allow_reactions" value="true" <%= 'checked="checked"' if collection&.operations&.allow_reactions %>/>
    </div>
    <p class="explanation">When enabled, reaction buttons are shown near images to logged in users. Users can react to the image (one reaction of every available kind per image).</p>
    <div class="form-row">
    <label for="allowed_reactions">Reactions offered to the users (space-separated)</label>
    <input type="text" id="allowed_reactions" name="allowed_reactions" value="<%= collection&.operations&.reactions&.join(' ') %>" maxlength="20"/>
    </div>
    <p class="explanation">Enter space-separated names displayed on reaction buttons. Since these are shown as is, emojis are a good choice here.</p>
    <div class="form-row">
    <label for="allow_comments" id="allow_comments">Allow visitors to comment on images?</label>
    <input type="checkbox" id="allow_comments" name="allow_comments" value="true" <%= 'checked="checked"' if collection&.operations&.allow_coments %>/>
    </div>
    <p class="explanation">When enabled, allows logged-in users to write comments about the image. Comments are visible to all visitors, even those that did not log in.</p>
  </fieldset>
  <fieldset>
    <legend>Image downloads</legend>
    <div class="form-row">
      <label for="allow_downloads" id="allow_downloads">Allow all users to download full-size images?</label>
      <input type="checkbox" id="allow_downloads" name="allow_downloads" value="true" <%= 'checked="checked"' if collection&.operations&.allow_downloads %>/>
    </div>
    <p class="explanation">When enabled, all users will be able to download the original image file. Note that resized images (miniatures and "full size") can always be downloaded, as they are displayed in the browser.</p>
  </fieldset>
  <fieldset>
    <legend>Other options</legend>
    <div class="form-row">
    <label for="description">Collection description</label>
    <textarea id="description" name="description"><%= collection&.description %></textarea>
    </div>
    <p class="explanation">A more detailed information about the collection.</p>
    <div class="form-row">
    <label for="information">Collection information</label>
    <textarea id="information" name="information"><%= collection&.information %></textarea>
    </div>
    <p class="explanation">This text is displayed at the bottom of the screen, together with site information.</p>
    <div class="form-row">
    <label for="password">Collection password</label>
    <input type="password" id="password" name="password" minlength="8" maxlength="32" value="<%= collection.password %>"/>
    </div>
    <p class="explanation">Password is not required. If it is not set, the collection will be publicly available. If it is present, it has to be between 8 and 32 characters long.
    When present, and visitors are enabled, the visitors have to enter the password to view the collection before they can log in.</p>
  </fieldset>
  <%= erb :_form_errors, locals: {form_errors: collection_errors} if collection_errors && !collection_errors.empty? %>
  <input type="submit" value="Create collection"/>
</form>
