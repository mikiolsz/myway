  <article class="nice-box">
    <header><h2>Password required</h2></header>
    <div class="description">
      The collection you are trying to view is protected by a password. You should have received it together with the link.
    </div>
  </article>
<section class="grid wide">
  <article id="collection-password" class="nice-box with-border">
    <header><h2>Continue with collection password</h2></header>
    <form method="post" action="/collection">
      <fieldset>
        <legend>Password required to continue</legend>
        <div class="form-row">
        <label for="password">Enter password to view collection <%= @context.collection.title %></label>
        <input type="password" id="password" name="password" />
        </div>
        <% if incorrect_password %>
          <p class="explanation">The password you entered was not correct.</p>
        <% end %>
        <input type="hidden" id="name" name="name" value="<%= @context.collection_name %>" />
      </fieldset>
      <input type="submit" value="Continue" />
    </form>
  </article>
  <% if @context.collection.operations.allow_visitors %>
  <article id="visitor-password" class="nice-box with-border">
    <header><h2>Continue with visitor account</h2></header>
    <p>If you already created a visitor account for this collection, you can <a href="/login/<%= @context.collection_name %>" rel="nofollow" class="has-icon visitor-login-link">log in as a visitor to <%= @context.collection.title %></a>.</p>
  </article>
  <% end %>

</section>
